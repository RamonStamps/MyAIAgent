{
  "name": "myaagent-vscode",
  "displayName": "MyAIAgent Chat",
  "description": "Integrates MyAIAgent CLI as a chat assistant inside VS Code.",
  "version": "0.1.0",
  "engines": {"vscode": "^1.60.0"},
  "main": "extension.js",
  "activationEvents": ["onCommand:myaagent.chat"],
  "contributes": {
    "commands": [
      {
        "command": "myaagent.chat",
        "title": "MyAIAgent: Open Chat"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "MyAIAgent",
      "properties": {
        "myaagent.executablePath": {
          "type": "string",
          "default": "${workspaceFolder}/MyAIAgent.exe",
          "description": "Path to the MyAIAgent executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./node_modules/vscode/bin/install",
    "build": "echo 'No build step; extension uses plain JS'",
    "test": "node ./test/runTests.js",
    "test:integration": "node ./test/runIntegrationTest.js",
    "test:webview": "node ./test/runIntegrationTest.js --grep webview.dom",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "@vscode/test-electron": "^2.4.0"
  }
}
